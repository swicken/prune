{
  "name": "@swicken/prune",
  "version": "4.7.0",
  "description": "Keep what earns its place. Readable, scoped, complete, verified engineering.",
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "prune"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./pi-extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --prefix pi-extension",
    "check": "node scripts/sync-rule-copies.js --check && node scripts/check-versions.js",
    "bench:compare": "python3 benchmarks/compare.py",
    "bench:agentic": "python3 benchmarks/agentic/run.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swicken/prune.git"
  }
}
